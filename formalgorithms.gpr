with "config/formalgorithms_config.gpr";
project Formalgorithms is

   for Source_Dirs use ("src/", "src/lemmas/", "src/types/", "src/scheduler/", "config/");
   for Object_Dir use "obj/" & Formalgorithms_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("formalgorithms.adb");

   package Compiler is
      for Default_Switches ("Ada") use Formalgorithms_Config.Ada_Compiler_Switches & ("-gnat12");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

   package Prove is
      for Proof_Switches ("Ada") use ("--mode=prove",
                           -- "--report=statistics",
                           -- "--proof=per_check",
                           "--warnings=continue",
                           "--counterexamples=on");
   end Prove;

end Formalgorithms;
